{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "zhuang：启动装箱工作台",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\PackingPortable\\python\\python.exe",
            "program": "${workspaceFolder}\\packing-system\\ui\\realtime_dashboard_v3_clean.py",
            "args": [
